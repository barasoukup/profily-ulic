# Data downloaded or derived from third-party sources: rebuild them locally (see pilot/README.md)
# instead of publishing them. OSM-derived tiles are an ODbL derivative database, technical-map
# extracts and cached IPR responses have unclear redistribution terms.
data/
pilot/cache/
pilot/data/

# Copy of the Streetmix repository (AGPL-3.0 code, CC BY-SA illustrations); the pilot only
# ships the illustrations it uses, in pilot/public/streetmix/ with their LICENSE.
vendor/

.DS_Store

# Evaluation results (orthophoto crops, cached profiles); the scripts in evaluation/ rebuild them.
evaluation/data/
evaluation/snapshot/
.claude/

# Local test page for building drawings (imports profile.js, never deployed)
pilot/public/test-budovy.html
# OSM-derived table (ODbL), rebuilt by evaluation/budovy-typ/labels.mjs
evaluation/budovy-typ/labels.tsv

# Local Mapy.com key (export const MAPY_KEY = "…"), never committed
pilot/public/config.local.js
