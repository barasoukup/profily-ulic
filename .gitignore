# Data downloaded or derived from third-party sources: rebuild them locally (see app/README.md)
# instead of publishing them. OSM-derived tiles are an ODbL derivative database, technical-map
# extracts and cached IPR responses have unclear redistribution terms.
data/
app/cache
app/data

# Copy of the Streetmix repository (AGPL-3.0 code, CC BY-SA illustrations); the app only
# ships the illustrations it uses, in app/public/streetmix/ with their LICENSE.
vendor/

.DS_Store

# Evaluation results (orthophoto crops, cached profiles); the scripts in evaluation/ rebuild them.
evaluation/data/
evaluation/archive/prague-100/snapshot/
.claude/

# Local test page for building drawings (imports profile.js, never deployed)
app/public/test-budovy.html
# OSM-derived table (ODbL), rebuilt by evaluation/archive/building-types/labels.mjs
evaluation/archive/building-types/labels.tsv

# Local Mapy.com key (export const MAPY_KEY = "…"), never committed
app/public/config.local.js

# Brno evaluation data (orthophoto tiles, results, review images); the scripts in evaluation/ rebuild them.
evaluation/brno/data/
# Evaluation data of the towns (orthophoto, results, review images); the scripts in evaluation/ rebuild them.
evaluation/*/data/

# Wrangler (Cloudflare) working files of logging/
.wrangler/

# Certificates joined for one run of tools/check_sources.mjs
tools/.ca-check.pem

# Bářiny dokumenty (Plus přístup), nepatří do repozitáře
Profily-ulic-Plus.docx
evaluation/archive/panel-buildings/cache.json
# Copies of evaluation scripts served to the app page during a run (evaluation/slovakia/check)
app/public/evaluation-*
# Working files of the agents' runs in the app's folder (copies of collectors, point lists), never deployed or committed
app/public/zz-*
# Esri World Imagery crops of the Lombardy A/B (not to be published: evaluation/italy/lombardia/REPORT.md) and its data
evaluation/italy/lombardia/images/
evaluation/italy/lombardia/data/
# Images over orthophotos licensed for viewing only (Vilnius's own orthophoto, Esri), wherever an A/B keeps them
evaluation/**/esri/
evaluation/*/ab/data/

node_modules/
