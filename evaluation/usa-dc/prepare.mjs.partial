// The DC pilot, the judge's inputs (as evaluation/universal/prepare.mjs and ortho.mjs, whose code this follows; the
// shared ortho.mjs is not changed): the orthophoto of DC 2025 (DC OCTO, Ortho2025_WebMercator, 8 cm, CC BY 4.0) resampled
// with the cut across the image, the street up, A on the left, 10 px = 1 m, a metre scale; the Mapillary photos along
// the street both ways (within 30 m). Writes data/<id>-ortho.jpg, -f.jpg, -b.jpg, <id>.txt.
//   node evaluation/usa-dc/prepare.mjs
import fs from "node:fs/promises";
import path from "node:path";
import os from "node:os";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { decodePng } from "../../app/public/dmvs.js";
import { encodePng } from "../ortofoto/run.mjs";
import { ROOT, DATA } from "./lib.mjs";

const run = promisify(execFile), R = 6378137, RES = 0.1, ALONG = 15;
const FONT = "/System/Library/Fonts/Supplemental/Arial Bold.ttf";
const merc = (lon, lat) => [(R * lon * Math.PI) / 180, R * Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 360))];
export const DC_ORTHO = "https://maps2.dcgis.dc.gov/dcgis/rest/services/DCGIS_DATA/Ortho2025_WebMercator/MapServer/export";
const TOKEN = (await fs.readFile(process.env.TOKEN || path.join(ROOT, "..", "streetview", "token.local"), "utf8")).trim();
const angle = (a, b) => Math.abs(((a - b + 540) % 360) - 180);

// A service's export of the box at w × h px; with EVAL_ORTHO_MAX (Esri World Imagery answers 500 above about 400 px, San
// Francisco 26. 11. 2026) in pieces of at most that size, put together.
async function exportImage(service, [x0, y0, x1, y1], w, h) {
  const one = async (b, pw, ph) => {
    const res = await fetch(`${service}${service.includes("?") ? "" : "?"}${new URLSearchParams({ bbox: b.join(","), bboxSR: 3857, imageSR: 3857, size: `${pw},${ph}`, format: "png24", f: "image" })}`, { headers: { "User-Agent": "profily-ulic evaluation" } });
    if (!res.ok) throw new Error(`ortofoto ${res.status}`);
    return decodePng(Buffer.from(await res.arrayBuffer()));
  };
  const max = Number(process.env.EVAL_ORTHO_MAX) || Infinity, finest = Number(process.env.EVAL_ORTHO_FINEST) || 0;
  // (Nor finer than EVAL_ORTHO_FINEST m of Web Mercator a pixel: Esri's 0.15; the picture is sampled from it as it is.)
  if (finest && (x1 - x0) / w < finest) { w = Math.ceil((x1 - x0) / finest); h = Math.ceil((y1 - y0) / finest); }
  if (w <= max && h <= max) return one([x0, y0, x1, y1], w, h);
  const rgba = new Uint8Array(w * h * 4), sx = (x1 - x0) / w, sy = (y1 - y0) / h;
  for (let j0 = 0; j0 < h; j0 += max) for (let i0 = 0; i0 < w; i0 += max) {
    const pw = Math.min(max, w - i0), ph = Math.min(max, h - j0);
    const part = await one([x0 + i0 * sx, y1 - (j0 + ph) * sy, x0 + (i0 + pw) * sx, y1 - j0 * sy], pw, ph);
    for (let j = 0; j < ph; j++) for (let i = 0; i < pw; i++) {
      const s = (Math.floor((j * part.height) / ph) * part.width + Math.floor((i * part.width) / pw)) * 4, o = ((j0 + j) * w + i0 + i) * 4;
      rgba.set(part.rgba.subarray(s, s + 4), o);
    }
  }
  return { width: w, height: h, rgba };
}
// A tile cache without an export (MassGIS's, evaluation/usa/boston; Bára 26. 11. 2026): its tiles of level 20 ({z}/{y}/{x},
// 256 px) over the box in Web Mercator joined, cut and resampled to w × h by ImageMagick.
const HALF_WORLD = 20037508.342789244;
async function tileMosaic(tiles, [x0, y0, x1, y1], w, h, z = 20) {
  const T = (2 * HALF_WORLD) / 2 ** z, tx0 = Math.floor((x0 + HALF_WORLD) / T), tx1 = Math.floor((x1 + HALF_WORLD) / T), ty0 = Math.floor((HALF_WORLD - y1) / T), ty1 = Math.floor((HALF_WORLD - y0) / T);
  const dir = await fs.mkdtemp(path.join(os.tmpdir(), "mosaic-")), rows = [];
  for (let ty = ty0; ty <= ty1; ty++) {
    const row = [];
    for (let tx = tx0; tx <= tx1; tx++) {
      const f = path.join(dir, `${ty}_${tx}.jpg`), r = await fetch(`${tiles}/${z}/${ty}/${tx}`, { headers: { "User-Agent": "profily-ulic evaluation" } });
      if (!r.ok) throw new Error(`dlaždice ortofota ${r.status}`);
      await fs.writeFile(f, Buffer.from(await r.arrayBuffer()));
      row.push(f);
    }
    rows.push(["(", ...row, "+append", ")"]);
  }
  const png = path.join(dir, "out.png"), px = (v) => Math.round(v * 256);
  const left = px((x0 + HALF_WORLD) / T - tx0), top = px((HALF_WORLD - y1) / T - ty0), cw = px((x1 - x0) / T), ch = px((y1 - y0) / T);
  await run("magick", [...rows.flat(), "-append", "-crop", `${cw}x${ch}+${left}+${top}`, "+repage", "-resize", `${w}x${h}!`, "-depth", "8", "-define", "png:color-type=6", png]);
  const img = await decodePng(await fs.readFile(png));
  await fs.rm(dir, { recursive: true, force: true });
  return img;
}
export async function orthoImage({ lat, lon, bearing, half = 30 }, out, { cut = true, service = DC_ORTHO, tiles = null } = {}) {
  const b = (bearing * Math.PI) / 180, dir = [Math.sin(b), Math.cos(b)], normal = [-Math.cos(b), Math.sin(b)];
  const kx = 111320 * Math.cos((lat * Math.PI) / 180), ky = 110574;
  const ll = (t, u) => [lon + (normal[0] * t + dir[0] * u) / kx, lat + (normal[1] * t + dir[1] * u) / ky];
  const corners = [];
  for (const t of [-half, half]) for (const u of [-ALONG, ALONG]) corners.push(merc(...ll(t, u)));
  const x0 = Math.min(...corners.map((p) => p[0])), x1 = Math.max(...corners.map((p) => p[0]));
  const y0 = Math.min(...corners.map((p) => p[1])), y1 = Math.max(...corners.map((p) => p[1]));
  const k = Math.cos((lat * Math.PI) / 180), w = Math.round(((x1 - x0) * k) / RES), h = Math.round(((y1 - y0) * k) / RES);
<<<<<<< O
  const img = await exportImage(service, [x0, y0, x1, y1], w, h);
||||||| B
